# Copy to .env and fill in. NEVER commit .env.
# Generate the secrets with:  node scripts/gen-secrets.mjs

DOMAIN=remote.example.com                 # your domain; DNS A record -> this server
SERVER_ORIGIN=https://remote.example.com  # must match DOMAIN (used for TLS, JWT issuer, agent challenge binding)

POSTGRES_PASSWORD=
JWT_PRIVATE_KEY=
COMMAND_SIGNING_KEY=
TOTP_ENC_KEY=
PEPPER=

# First owner account can register once; keep false afterwards unless you add users.
REGISTRATION_ENABLED=false
REQUIRE_TOTP_FOR_COMMANDS=true
MIN_AGENT_VERSION=0.1.0

# Filled in during Phase 5 (RustDesk). Returned to authenticated clients on CONNECT.
RUSTDESK_ID_SERVER=
RUSTDESK_RELAY_SERVER=
RUSTDESK_PUBLIC_KEY=
